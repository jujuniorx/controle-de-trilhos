// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Use Prisma Data Proxy URL for Vercel (Accelerate)
  url = env("DATABASE_URL")
  // Direct URL for migrations (only needed locally and in build)
  directUrl = env("DIRECT_DATABASE_URL")
}

enum TipoMovimentacao {
  RECEBIMENTO
  REMETIDO
}

enum StatusMovimentacao {
  AGUARDANDO_CHEGADA
  PENDENTE_CONFERENCIA
  CONFERIDO
}

enum TipoTransporte {
  CAMINHAO
  VAGAO
  OUTRO
}

enum TipoRemetido {
  VENDA
  TRANS
  INDUS
}

enum PerfilTrilho {
  TR22
  TR32
  TR37
  TR40
  TR45
  TR50
  TR54
  TR55
  TR57
  TR60
  TR68
  // "Diversos" do Remetido: tocos de sucata pesados juntos, sem medição — só o peso
  // (informado pelo Administrativo na pesagem). Só existe em grupos de SUCATA do Remetido.
  TOCO
}

enum TipoMaterial {
  NOVO
  REEMPREGO
  SUCATA
}

enum ClassificacaoReemprego {
  G1
  G2
  G3
}

enum ClassificacaoSC {
  SC1
  SC2
  SC3
  DIVERSOS
}

enum ModoMedicao {
  INDIVIDUAL
  QTD_COMPRIMENTO
}

enum Role {
  ADMIN
  // Dono do sistema: além do que o ADMIN faz, gerencia usuários, exclui movimentações e vê a auditoria.
  DONO
  // Portaria: só vê e preenche os dados do motorista/caminhão e libera a carreta. Nunca entra no Administrativo.
  PORTARIA
}

model User {
  id            String    @id @default(cuid())
  nome          String
  email         String    @unique
  // Opcional: a conta de teste original só tem e-mail. Login aceita usuário OU
  // e-mail no mesmo campo — ver lib/services/loginService.ts.
  username      String?   @unique
  senhaHash     String
  role          Role      @default(ADMIN)
  ativo         Boolean   @default(true)
  createdAt     DateTime  @default(now())
  ultimoLoginEm DateTime?
  sessions      Session[]
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
}

model LoginAttempt {
  id            String    @id @default(cuid())
  identificador String    @unique
  tentativas    Int       @default(0)
  bloqueadoAte  DateTime?
  atualizadoEm  DateTime  @updatedAt
}

model PatioAcessoToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
}

model Movimentacao {
  id               String             @id @default(cuid())
  clientId         String             @unique
  tipo             TipoMovimentacao
  tipoDocumento    String
  numeroDocumento  String?
  tipoTransporte   TipoTransporte
  placaCavalo      String?
  placaCarreta     String?
  placaCarreta2    String?
  transportadora   String?
  origem           String?
  destino          String?
  reservaPedido    String?
  responsavelPatio String?
  dataMovimentacao DateTime?
  status           StatusMovimentacao @default(PENDENTE_CONFERENCIA)
  createdAt        DateTime           @default(now())
  conferidoPorId   String?
  conferidoEm      DateTime?
  pesoSucataReal   Decimal?

  // Portaria (só Remetido): dados do motorista/caminhão preenchidos na chegada.
  motoristaNome      String?
  motoristaCpf       String?
  motoristaTelefone  String?
  capacidadeCarga    Decimal? // toneladas
  materialPrevisto   String?
  // O Pátio marca que terminou de medir (só falta a carreta chegar).
  medicaoConcluidaEm DateTime?
  // A Portaria libera a carreta para carregar/descarregar — dispara o aviso no Pátio.
  carretaLiberadaEm  DateTime?
  carretaLiberadaPor String?

  remetidoDetalhe RemetidoDetalhe?
  grupos          Grupo[]
  anexos          Anexo[]
  historico       HistoricoAlteracao[]
}

model RemetidoDetalhe {
  movimentacaoId String        @id
  movimentacao   Movimentacao  @relation(fields: [movimentacaoId], references: [id])
  // Opcional: no lançamento direto pelo Pátio (sem pré-cadastro) o Pátio não tem
  // essa informação — o Administrativo completa depois, na conferência.
  tipoRemetido   TipoRemetido?
}

model Grupo {
  id             String                  @id @default(cuid())
  clientId       String                  @unique
  movimentacaoId String
  movimentacao   Movimentacao            @relation(fields: [movimentacaoId], references: [id])
  perfil         PerfilTrilho
  tipoMaterial   TipoMaterial
  classificacao  ClassificacaoReemprego?
  fabricante     String?
  metrosTotal    Decimal                 @default(0)
  pesoCalculado  Decimal?
  pesoInformado  Decimal?
  tampao         Boolean                 @default(false)

  medicoes Medicao[]
  anexos   Anexo[]
}

model Medicao {
  id              String           @id @default(cuid())
  clientId        String           @unique
  grupoId         String
  grupo           Grupo            @relation(fields: [grupoId], references: [id])
  modo            ModoMedicao
  quantidade      Int              @default(1)
  comprimento     Decimal
  metros          Decimal
  classificacaoSC ClassificacaoSC?
}

model Anexo {
  id             String       @id @default(cuid())
  movimentacaoId String
  movimentacao   Movimentacao @relation(fields: [movimentacaoId], references: [id])
  grupoId        String?
  grupo          Grupo?       @relation(fields: [grupoId], references: [id])
  tipo           String
  url            String
  uploadedById   String
  uploadedAt     DateTime     @default(now())
}

model FatorPerfil {
  perfil PerfilTrilho @id
  fator  Decimal
}

// Registro de ações sensíveis do Administrativo (exclusões, gestão de usuários). Só leitura pelo DONO.
model LogAuditoria {
  id          String   @id @default(cuid())
  usuarioId   String?
  usuarioNome String
  acao        String
  descricao   String
  criadoEm    DateTime @default(now())

  @@index([criadoEm])
}

// Lixeira: cópia completa (JSON) de uma movimentação no momento em que o dono a exclui.
// Permite restaurar com tudo (grupos, medições, anexos, histórico) pela tela /admin/lixeira.
model MovimentacaoExcluida {
  id              String           @id @default(cuid())
  movimentacaoId  String
  tipo            TipoMovimentacao
  rotulo          String
  dados           Json
  excluidoPorId   String?
  excluidoPorNome String
  excluidoEm      DateTime         @default(now())
  restauradoEm    DateTime?

  @@index([excluidoEm])
}

model HistoricoAlteracao {
  id             String       @id @default(cuid())
  movimentacaoId String
  movimentacao   Movimentacao @relation(fields: [movimentacaoId], references: [id])
  usuarioId      String?
  usuarioNome    String
  acao           String
  campo          String?
  valorAntigo    String?
  valorNovo      String?
  timestamp      DateTime     @default(now())
}

// Aparelhos do Pátio que aceitaram receber avisos (web push). O Pátio não tem usuário, então
// a inscrição é só do aparelho (endpoint único).
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}
