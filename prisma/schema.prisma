// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Use Prisma Data Proxy URL for Vercel (Accelerate)
  url = env("DATABASE_URL")
  // Direct URL for migrations (only needed locally and in build)
  directUrl = env("DIRECT_DATABASE_URL")
}

enum TipoMovimentacao {
  RECEBIMENTO
  REMETIDO
}

enum StatusMovimentacao {
  AGUARDANDO_CHEGADA
  PENDENTE_CONFERENCIA
  CONFERIDO
}

enum TipoTransporte {
  CAMINHAO
  VAGAO
  OUTRO
}

enum TipoRemetido {
  VENDA
  TRANS
  INDUS
}

enum PerfilTrilho {
  TR22
  TR32
  TR37
  TR40
  TR45
  TR50
  TR54
  TR55
  TR57
  TR60
  TR68
  // "Diversos" do Remetido: tocos de sucata pesados juntos, sem medição — só o peso
  // (informado pelo Administrativo na pesagem). Só existe em grupos de SUCATA do Remetido.
  TOCO
}

enum TipoMaterial {
  NOVO
  REEMPREGO
  SUCATA
}

enum ClassificacaoReemprego {
  G1
  G2
  G3
}

enum ClassificacaoSC {
  SC1
  SC2
  SC3
  DIVERSOS
}

enum ModoMedicao {
  INDIVIDUAL
  QTD_COMPRIMENTO
}

enum Role {
  ADMIN
  // Dono do sistema: além do que o ADMIN faz, gerencia usuários, exclui movimentações e vê a auditoria.
  DONO
  // Portaria: só vê e preenche os dados do motorista/caminhão e libera a carreta. Nunca entra no Administrativo.
  PORTARIA
}

model User {
  id            String    @id @default(cuid())
  nome          String
  email         String    @unique
  // Opcional: a conta de teste original só tem e-mail. Login aceita usuário OU
  // e-mail no mesmo campo — ver lib/services/loginService.ts.
  username      String?   @unique
  senhaHash     String
  role          Role      @default(ADMIN)
  ativo         Boolean   @default(true)
  createdAt     DateTime  @default(now())
  ultimoLoginEm DateTime?
  sessions      Session[]
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
}

model LoginAttempt {
  id            String    @id @default(cuid())
  identificador String    @unique
  tentativas    Int       @default(0)
  bloqueadoAte  DateTime?
  atualizadoEm  DateTime  @updatedAt
}

model PatioAcessoToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
}

model Movimentacao {
  id               String             @id @default(cuid())
  clientId         String             @unique
  tipo             TipoMovimentacao
  tipoDocumento    String
  numeroDocumento  String?
  // Carregamento com mais de uma NF: a principal fica em numeroDocumento; as outras, aqui.
  numerosDocumentoExtras String[] @default([])
  tipoTransporte   TipoTransporte
  placaCavalo      String?
  placaCarreta     String?
  placaCarreta2    String?
  transportadora   String?
  origem           String?
  destino          String?
  reservaPedido    String?
  responsavelPatio String?
  dataMovimentacao DateTime?
  status           StatusMovimentacao @default(PENDENTE_CONFERENCIA)
  createdAt        DateTime           @default(now())
  conferidoPorId   String?
  conferidoEm      DateTime?
  pesoSucataReal   Decimal?
  // Observação livre escrita pelo pessoal do Pátio.
  observacao       String?

  // Portaria (só Remetido): dados do motorista/caminhão preenchidos na chegada.
  motoristaNome      String?
  motoristaCpf       String?
  motoristaTelefone  String?
  capacidadeCarga    Decimal? // toneladas
  comprimentoCarreta Decimal? // metros
  materialPrevisto   String?
  // O Pátio marca que terminou de medir (só falta a carreta chegar).
  medicaoConcluidaEm DateTime?
  // A Portaria libera a carreta para carregar/descarregar — dispara o aviso no Pátio.
  carretaLiberadaEm  DateTime?
  carretaLiberadaPor String?
  chegadaPortariaEm DateTime?
  chegadaPortariaPor String?
  saidaPortariaEm DateTime?
  saidaPortariaPor String?
  // Observação escrita pela Portaria para o Pátio.
  observacaoPortaria String?

  remetidoDetalhe RemetidoDetalhe?
  grupos          Grupo[]
  anexos          Anexo[]
  historico       HistoricoAlteracao[]
}

model RemetidoDetalhe {
  movimentacaoId String        @id
  movimentacao   Movimentacao  @relation(fields: [movimentacaoId], references: [id])
  // Opcional: no lançamento direto pelo Pátio (sem pré-cadastro) o Pátio não tem
  // essa informação — o Administrativo completa depois, na conferência.
  tipoRemetido   TipoRemetido?
}

model Grupo {
  id             String                  @id @default(cuid())
  clientId       String                  @unique
  movimentacaoId String
  movimentacao   Movimentacao            @relation(fields: [movimentacaoId], references: [id])
  perfil         PerfilTrilho
  tipoMaterial   TipoMaterial
  classificacao  ClassificacaoReemprego?
  fabricante     String?
  metrosTotal    Decimal                 @default(0)
  pesoCalculado  Decimal?
  pesoInformado  Decimal?
  tampao         Boolean                 @default(false)

  medicoes Medicao[]
  anexos   Anexo[]
}

model Medicao {
  id              String           @id @default(cuid())
  clientId        String           @unique
  grupoId         String
  grupo           Grupo            @relation(fields: [grupoId], references: [id])
  modo            ModoMedicao
  quantidade      Int              @default(1)
  comprimento     Decimal
  metros          Decimal
  classificacaoSC ClassificacaoSC?
}

model Anexo {
  id             String       @id @default(cuid())
  movimentacaoId String
  movimentacao   Movimentacao @relation(fields: [movimentacaoId], references: [id])
  grupoId        String?
  grupo          Grupo?       @relation(fields: [grupoId], references: [id])
  tipo           String
  url            String
  uploadedById   String
  uploadedAt     DateTime     @default(now())
}

model FatorPerfil {
  perfil PerfilTrilho @id
  fator  Decimal
}

// Registro de ações sensíveis do Administrativo (exclusões, gestão de usuários). Só leitura pelo DONO.
model LogAuditoria {
  id          String   @id @default(cuid())
  usuarioId   String?
  usuarioNome String
  acao        String
  descricao   String
  criadoEm    DateTime @default(now())

  @@index([criadoEm])
}

// Lixeira: cópia completa (JSON) de uma movimentação no momento em que o dono a exclui.
// Permite restaurar com tudo (grupos, medições, anexos, histórico) pela tela /admin/lixeira.
model MovimentacaoExcluida {
  id              String           @id @default(cuid())
  movimentacaoId  String
  tipo            TipoMovimentacao
  rotulo          String
  dados           Json
  excluidoPorId   String?
  excluidoPorNome String
  excluidoEm      DateTime         @default(now())
  restauradoEm    DateTime?

  @@index([excluidoEm])
}

model HistoricoAlteracao {
  id             String       @id @default(cuid())
  movimentacaoId String
  movimentacao   Movimentacao @relation(fields: [movimentacaoId], references: [id])
  usuarioId      String?
  usuarioNome    String
  acao           String
  campo          String?
  valorAntigo    String?
  valorNovo      String?
  timestamp      DateTime     @default(now())
}

// Aparelhos do Pátio que aceitaram receber avisos (web push). O Pátio não tem usuário, então
// a inscrição é só do aparelho (endpoint único).
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  setor String @default("PATIO")
  createdAt DateTime @default(now())
}

// Portaria — Recebimento: o caminhão chega, a Portaria cadastra os dados e libera para descarregar
// (o Pátio é avisado). Sem chave estrangeira para a movimentação de propósito: excluir/restaurar
// movimentações (Lixeira) não pode ser travado por esta tabela.
model ChegadaCaminhao {
  id                String    @id @default(cuid())
  origem            String?
  materialPrevisto  String?
  transportadora    String?
  motoristaNome     String?
  motoristaCpf      String?
  motoristaTelefone String?
  placaCarreta      String?
  placaCarreta2     String?
  placaCavalo       String?
  capacidadeCarga   Decimal? // toneladas
  comprimentoCarreta Decimal? // metros
  observacao        String? // da Portaria, para o Pátio
  criadoPor         String
  criadoEm          DateTime  @default(now())
  liberadaEm        DateTime?
  liberadaPor       String?
  canceladaEm       DateTime?
  // Preenchidos quando o Pátio conclui o recebimento a partir desta chegada.
  movimentacaoId    String?   @unique
  recebidaEm        DateTime?
  // Pátio descarregou e libera a saída antes da medição (medição fica para depois).
  descarregadaEm    DateTime?
  descarregadaPor   String?
  saidaEm DateTime?
  saidaPor String?

  @@index([criadoEm])
}

// ─── Relatório da Usina (aba do Administrativo) ───────────────────────────────
// Lançamentos preenchidos pelo Administrativo. Os setores são: Estaleiro de solda,
// Geração de trilho, Trilheiro e Caminhão de solda. Carregamento da carreta NÃO tem
// tabela: vem dos remetidos já lançados no sistema.

enum LiderGeracao {
  ALECIO
  BRUNO
  REGINALDO
}

enum ComposicaoAtiva {
  W61
  W62
}

enum TrilheiroCod {
  E40
  E42
  E46
}

enum CaminhaoSolda {
  CW01
  CW02
  CW03
}

// Tipos de TLS controlados no estaleiro de solda.
enum TipoTls {
  UIC60_REEMPREGO
  UIC60_NOVO
  GB60_REEMPREGO
  TR68_REEMPREGO
  TR68_NOVO
}

// Estaleiro de solda: produção do dia (soldas e cortes).
model EstaleiroDia {
  id        String   @id @default(cuid())
  data      DateTime @unique @db.Date
  soldas    Int?
  cortes    Int?
  atualizadoEm DateTime @updatedAt
}

// Estaleiro de solda: dia da manutenção de cada semana (padrão sexta, mas pode trocar).
// A chave é a segunda-feira da semana.
model ManutencaoSemana {
  id              String   @id @default(cuid())
  semanaInicio    DateTime @unique @db.Date
  diaManutencao   DateTime @db.Date
  atualizadoEm    DateTime @updatedAt
}

// Estaleiro de solda: estoque de TLS por tipo, por dia.
model EstoqueTlsDia {
  id         String   @id @default(cuid())
  data       DateTime @db.Date
  tipo       TipoTls
  quantidade Int
  atualizadoEm DateTime @updatedAt

  @@unique([data, tipo])
}

// Segunda-feira: escala da semana (formato a definir).
model EscalaSemana {
  id           String   @id @default(cuid())
  semanaInicio DateTime @unique @db.Date
  conteudo     String?
  atualizadoEm DateTime @updatedAt
}

// Geração de trilho: lançamento diário por líder.
model GeracaoDia {
  id            String        @id @default(cuid())
  data          DateTime      @db.Date
  lider         LiderGeracao
  local         String?
  corteM        Decimal?
  carregamentoM Decimal?
  perfil        String?
  quantidade    Int?
  deixadaViaM   Decimal?
  observacao    String?
  atualizadoEm  DateTime      @updatedAt

  @@unique([data, lider])
}

// Composições ativas (W61 e W62): barras e jacarés por dia.
model ComposicaoDia {
  id           String          @id @default(cuid())
  data         DateTime        @db.Date
  ativo        ComposicaoAtiva
  barras       Int?
  jacares      Int?
  observacao   String?
  atualizadoEm DateTime        @updatedAt

  @@unique([data, ativo])
}

// Trilheiro: um giro completo (do B.O. até o retorno). O tempo na usina é
// chegadaUsinaEm -> partidaEm, em dias úteis.
model TrilheiroGiro {
  id            String        @id @default(cuid())
  trilheiro     TrilheiroCod
  boEm          DateTime?     @db.Date
  chegadaUsinaEm DateTime?    @db.Date
  partidaEm     DateTime?     @db.Date
  retornoEm     DateTime?     @db.Date
  perfil        TipoTls?
  carregados    Int           @default(0)
  descarregados Int           @default(0)
  local         String?
  observacao    String?
  criadoEm      DateTime      @default(now())
  atualizadoEm  DateTime      @updatedAt

  @@index([trilheiro, boEm])
}

// Trilheiro: manutenções registradas (data, tipo e detalhamento).
model TrilheiroManutencao {
  id           String       @id @default(cuid())
  data         DateTime     @db.Date
  trilheiro    TrilheiroCod
  local        String?
  tipo         String?
  detalhamento String?
  atualizadoEm DateTime     @updatedAt

  @@index([trilheiro, data])
}

// Caminhão de solda: produção diária por caminhão (CW03 entra depois).
model CaminhaoSoldaDia {
  id              String        @id @default(cuid())
  data            DateTime      @db.Date
  caminhao        CaminhaoSolda
  local           String?
  producaoDiaria  Int?
  inicioMacro1    String?
  terminoMacro9   String?
  perdaDiaria     Int?
  atualizadoEm    DateTime      @updatedAt

  @@unique([data, caminhao])
}

// Feriados considerados nos dias úteis (nacionais, estaduais de SP e municipais de Bauru).
model Feriado {
  data      DateTime @id @db.Date
  nome      String
}
