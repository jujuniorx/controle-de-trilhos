# Postgres (Neon). DATABASE_URL = conexão pooled (pgbouncer), usada em runtime pelo Prisma Client.
# DIRECT_DATABASE_URL = conexão direta (sem pooling), exigida pelo `prisma migrate deploy`/`migrate dev`.
# Na Neon, o dashboard do projeto mostra as duas variantes da mesma connection string.
DATABASE_URL=
DIRECT_DATABASE_URL=

# Credenciais do primeiro usuário admin, usadas por `npx prisma db seed` (prisma/seed.ts).
ADMIN_EMAIL=
ADMIN_SENHA_INICIAL=

# Acesso do Pátio por PIN. PATIO_PIN_HASH é o hash Argon2id do PIN (nunca o PIN em texto puro) —
# gerar com `hashSegredo()` de lib/services/auth.ts. PATIO_PIN_TESTE é o PIN em texto puro,
# usado só pelos testes E2E (tests/e2e/helpers.ts) para preencher o formulário de acesso.
#
# ATENÇÃO — escape todo "$" do hash como "\$" neste arquivo (e no .env/.env.local reais).
# O loader de env do Next.js (@next/env) expande "$NOME" como se fosse uma variável de
# ambiente antes de popular process.env; um hash Argon2id (formato $argon2id$v=19$m=...$...)
# sem escape é silenciosamente corrompido, e o PIN passa a ser recusado mesmo estando correto
# — só em ambientes que carregam o segredo via arquivo .env (Vercel injeta env vars direto no
# processo, sem passar por essa expansão, então produção não é afetada por este bug específico).
# Exemplo (com escape, igual ao formato real do argon2):
# PATIO_PIN_HASH=\$argon2id\$v=19\$m=65536,p=4,t=3\$<salt-base64>\$<hash-base64>
PATIO_PIN_HASH=
PATIO_PIN_TESTE=

# Cloudflare R2 (armazenamento do Documento de pesagem). Opcional em dev/teste: se ausente,
# scripts/s3-mock.ts sobe um S3 compatível local (usado pelos testes de integração/E2E que
# exercitam upload). Necessário só para apontar a um bucket R2 real.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
